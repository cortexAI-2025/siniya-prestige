rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Menu images - public read
    match /menuImages/{imageId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.role == 'admin';
    }

    // User avatars
    match /userAvatars/{userId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Restaurant images - public read
    match /restaurantImages/{restaurantId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.role == 'admin';
    }
  }
}
